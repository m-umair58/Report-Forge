{
  "name": "@reportforge/cli",
  "version": "0.0.0",
  "description": "Official command-line interface for ReportForge",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "reportforge": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@reportforge/core": "workspace:*",
    "@reportforge/plugin-loader": "workspace:*",
    "@reportforge/plugin-sdk": "workspace:*",
    "@reportforge/render": "workspace:*",
    "@reportforge/shared": "workspace:*",
    "@reportforge/templates": "workspace:*",
    "@reportforge/themes": "workspace:*",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "inquirer": "^12.6.0",
    "jiti": "^2.4.2",
    "open": "^10.1.2",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
