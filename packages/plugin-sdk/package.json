{
  "name": "@reportforge/plugin-sdk",
  "version": "0.0.0",
  "description": "Official Plugin SDK for ReportForge",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@reportforge/shared": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
