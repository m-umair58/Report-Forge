{
  "name": "@reportforge/templates-core",
  "version": "0.0.0",
  "description": "Core template engine for ReportForge document templates",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@reportforge/core": "workspace:*",
    "@reportforge/shared": "workspace:*",
    "@reportforge/theme": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
