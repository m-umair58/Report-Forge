{
  "name": "@reportforge/core",
  "version": "0.0.0",
  "description": "Core package for ReportForge",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@reportforge/display-list": "workspace:*",
    "@reportforge/layout": "workspace:*",
    "@reportforge/renderer-pdf": "workspace:*",
    "@reportforge/shared": "workspace:*"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
